{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "sie": {
    "color": {
      "brand": {
        "primary": {
          "$type": "color",
          "$value": "#0B3367",
          "$description": "Cor principal solicitada para identidade, ações primárias e seleção."
        },
        "secondary": {
          "$type": "color",
          "$value": "#061E3D",
          "$description": "Cor secundária solicitada para shell, superfícies inversas e navegação."
        },
        "highlight": {
          "$type": "color",
          "$value": "#3EC7D3",
          "$description": "Acento único para telemetria, foco contextual e dados selecionados."
        },
        "highlightSoft": {
          "$type": "color",
          "$value": "#DFF7F8"
        }
      },
      "surface": {
        "canvas": {
          "$type": "color",
          "$value": "#F3F6FA"
        },
        "base": {
          "$type": "color",
          "$value": "#FFFFFF"
        },
        "subtle": {
          "$type": "color",
          "$value": "#E9EFF6"
        },
        "muted": {
          "$type": "color",
          "$value": "#DDE6F0"
        },
        "inverse": {
          "$type": "color",
          "$value": "#061E3D"
        },
        "inverseRaised": {
          "$type": "color",
          "$value": "#0B3367"
        },
        "inverseHover": {
          "$type": "color",
          "$value": "#12427C"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "#10243F"
        },
        "secondary": {
          "$type": "color",
          "$value": "#52667F"
        },
        "tertiary": {
          "$type": "color",
          "$value": "#71829A"
        },
        "inverse": {
          "$type": "color",
          "$value": "#F8FBFF"
        },
        "inverseMuted": {
          "$type": "color",
          "$value": "#B9C9DC"
        }
      },
      "border": {
        "subtle": {
          "$type": "color",
          "$value": "#D6DFE9"
        },
        "strong": {
          "$type": "color",
          "$value": "#9AABBE"
        },
        "inverse": {
          "$type": "color",
          "$value": "#27496F"
        }
      },
      "status": {
        "success": {
          "$type": "color",
          "$value": "#087A5B"
        },
        "successSubtle": {
          "$type": "color",
          "$value": "#DDF4EC"
        },
        "warning": {
          "$type": "color",
          "$value": "#915600"
        },
        "warningSubtle": {
          "$type": "color",
          "$value": "#FFF0D2"
        },
        "danger": {
          "$type": "color",
          "$value": "#B4233A"
        },
        "dangerSubtle": {
          "$type": "color",
          "$value": "#FBE7EA"
        },
        "info": {
          "$type": "color",
          "$value": "#0B5CAD"
        },
        "infoSubtle": {
          "$type": "color",
          "$value": "#E1EEFC"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "#1B70D4"
      },
      "chart": {
        "series1": {
          "$type": "color",
          "$value": "#0B3367"
        },
        "series2": {
          "$type": "color",
          "$value": "#137A87"
        },
        "series3": {
          "$type": "color",
          "$value": "#486F9F"
        },
        "series4": {
          "$type": "color",
          "$value": "#9A6715"
        },
        "grid": {
          "$type": "color",
          "$value": "#D6DFE9"
        }
      }
    },
    "dimension": {
      "space": {
        "0": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "1": {
          "$type": "dimension",
          "$value": {
            "value": 4,
            "unit": "px"
          }
        },
        "2": {
          "$type": "dimension",
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "3": {
          "$type": "dimension",
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "4": {
          "$type": "dimension",
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "5": {
          "$type": "dimension",
          "$value": {
            "value": 20,
            "unit": "px"
          }
        },
        "6": {
          "$type": "dimension",
          "$value": {
            "value": 24,
            "unit": "px"
          }
        },
        "8": {
          "$type": "dimension",
          "$value": {
            "value": 32,
            "unit": "px"
          }
        },
        "10": {
          "$type": "dimension",
          "$value": {
            "value": 40,
            "unit": "px"
          }
        },
        "12": {
          "$type": "dimension",
          "$value": {
            "value": 48,
            "unit": "px"
          }
        }
      },
      "radius": {
        "control": {
          "$type": "dimension",
          "$value": {
            "value": 6,
            "unit": "px"
          }
        },
        "panel": {
          "$type": "dimension",
          "$value": {
            "value": 10,
            "unit": "px"
          }
        },
        "pill": {
          "$type": "dimension",
          "$value": {
            "value": 999,
            "unit": "px"
          }
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Inter",
            "Segoe UI",
            "Arial",
            "sans-serif"
          ]
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "IBM Plex Mono",
            "Cascadia Code",
            "Consolas",
            "monospace"
          ]
        }
      }
    },
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": {
          "value": 80,
          "unit": "ms"
        }
      },
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 140,
          "unit": "ms"
        }
      },
      "standard": {
        "$type": "duration",
        "$value": {
          "value": 220,
          "unit": "ms"
        }
      }
    }
  }
}

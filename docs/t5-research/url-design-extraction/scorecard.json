      "feature": "lib/sanitize.cjs — value sanitization layer",
      "source": "own (visual regression triage from React DS Detail consumer)",
      "rejects": [
        "unset / initial / revert / revert-layer (global reset keywords)",
        "inherit / currentColor in color fields (host-context leak)",
        "outline shorthand ending in vivid named color (red/blue/green/lime/etc — debug rules)",
        "transform: scale(0|0.0|0,0) (hidden-state transforms)",
        "rotate(180deg) / rotateX(180deg) (Swiper/Slick prev-arrow flip)",
        "values containing --nav-- / --hamburger / --menu- / --header- / --drawer- / --popover- (foreign-component vars)",
        "values containing --swiper- / --carousel- / --slider- / --slick- / --owl- / --splide- / --gallery- (third-party widget vars)",
        "padding/radius/border-width values 0 / 0 0 / 0 0 0 0 (broad CSS resets)",
        "opacity = 0 in base contract (hidden-by-default state)",
        "opacity = NaN after Number() (numeric guard)",
        "CSS-module hash variant names (module__VSkE6q__buttonActions → buttonActions, with duplicate merge)"
